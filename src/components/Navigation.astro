---
import LogoMark from './LogoMark.astro';

// Anchor links target sections on the home page; prefix with "/" on subpages
const isHome = Astro.url.pathname === '/';
const anchor = (hash: string) => (isHome ? hash : `/${hash}`);
---

<nav
  id="site-nav"
  class="sticky top-0 z-50 border-b border-stone-200/80 bg-stone-50/80 backdrop-blur-md backdrop-saturate-150 transition-shadow duration-300"
>
  {/* The unprefixed type and padding steps below `sm` keep the whole row inside
      288px (a 320px viewport minus px-4); the `sm:` values are the design size
      and are unchanged. Heights are deliberately untouched — min-h and py stay.

      Brand block = logo mark + name. Below 380px the name is visually hidden
      (sr-only, still read out) and only the 28px mark stays, because mark + name
      (128.78px) + link group (188.44px) need 317.22px, i.e. a viewport of at
      least 349px. Measured 2026-11-03 via CDP, clientWidth == scrollWidth at
      320/379/380/390/700/768/1280; spare space: 71.56px at 320 (mark only),
      30.78px at 380 (mark + name). A fourth nav link, a longer label or a wider
      font eats into that — re-measure, and move the 380px threshold with it.
      A webfont failure is the safe direction: without Inter the text is narrower. */}
  <div class="max-w-content mx-auto px-4 sm:px-7 py-2 sm:py-2.5 flex items-center justify-between">
    <a
      href="/"
      class="group text-[14px] sm:text-[17px] font-bold tracking-tight text-stone-900 whitespace-nowrap py-2 min-h-[44px] flex items-center gap-2 sm:gap-2.5"
    >
      <LogoMark size={30} class="w-[28px] h-[28px] sm:w-[30px] sm:h-[30px] shrink-0 transition-transform duration-300 motion-safe:group-hover:scale-[1.06]" />
      <span class="max-[380px]:sr-only">Pascal Krason</span>
    </a>
    <div class="flex items-center sm:gap-1">
      <a
        href={anchor('#career')}
        class="text-[13px] sm:text-[14.5px] font-medium text-stone-600 hover:text-orange-700 transition-colors px-1.5 sm:px-3.5 py-2 rounded-lg min-h-[44px] flex items-center"
      >
        Career
      </a>
      <a
        href={anchor('#works')}
        class="text-[13px] sm:text-[14.5px] font-medium text-stone-600 hover:text-orange-700 transition-colors px-1.5 sm:px-3.5 py-2 rounded-lg min-h-[44px] flex items-center"
      >
        Projects
      </a>
      <a
        href={anchor('#contact')}
        class="text-[13px] sm:text-[14.5px] font-semibold text-white bg-orange-700 hover:bg-orange-800 transition-colors px-2.5 sm:px-4 py-2 rounded-lg ml-0.5 sm:ml-1.5 min-h-[44px] flex items-center"
      >
        Contact
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('site-nav');
  const onScroll = () => {
    nav?.classList.toggle('nav-scrolled', window.scrollY > 8);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
