---
// Opt-in gate for Microsoft Clarity. Rendered on every page, hidden until the
// script finds no stored decision, so a visitor who already chose never sees it
// again.
//
// Deliberately last in the body and not a dialog: the skip link stays the first
// focusable element, the banner is the last stop in the tab order (which is
// where it sits visually), and nothing traps focus. Reading on without deciding
// is allowed and means no tracking — scrolling, Escape and navigating away are
// all non-answers, not consent.
//
// `fixed` keeps it out of the flow: unhiding it shifts no content, so CLS is
// unaffected. The price is that it covers the bottom of the document, which
// the script below pays for with reserved space — see there.
//
// `border-stone-500` on Decline and `text-orange-700` on the link deviate from
// the site's usual stone-300/orange-600 on purpose: both of those miss their
// WCAG contrast minimum here (1.49:1 and 3.58:1 measured against the Tailwind 4
// oklch palette), and a refusal with no perceivable boundary is not an equal
// choice next to a filled button. The replacements were measured too, not
// guessed: stone-500 border 4.79:1 against white (SC 1.4.11 needs 3:1) and
// orange-700 text 5.22:1 (SC 1.4.3 needs 4.5:1 at this size). Putting either
// back "on convention" reintroduces a failure.
---

<div
  id="consent-banner"
  hidden
  role="region"
  aria-labelledby="consent-banner-title"
  class="fixed inset-x-0 bottom-0 z-[70] px-4 pb-4 sm:px-6 sm:pb-6"
>
  <div class="max-w-content mx-auto rounded-2xl border border-stone-200 bg-white p-5 shadow-xl sm:p-6">
    <h2 id="consent-banner-title" class="text-[17px] font-semibold text-stone-900">
      Help me improve this site?
    </h2>
    <p class="mt-2 text-[15px] leading-relaxed text-stone-600">
      I'd like to use Microsoft Clarity to see which parts of this portfolio people actually read.
      It records your clicks and scrolling and stores two cookies and a session token. Entirely
      your choice — the site works the same either way.
    </p>
    {/* Both buttons carry the same weight on purpose: same row, same height, and
        equal widths by construction (`flex-1` inside a container of known
        width), so refusing is exactly as easy as agreeing. Neither is
        pre-selected and neither takes autofocus.

        `border-transparent` on Allow is load-bearing, not decoration: with
        `flex-basis: 0` under `box-sizing: border-box` the free space is split
        evenly *after* each item's padding and border, so Decline's 1px border
        made it 2px wider than Allow at every width. Equal borders make the two
        measure identically. */}
    <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
      <div class="flex gap-3 sm:w-72 sm:shrink-0">
        <button
          id="consent-allow"
          type="button"
          class="flex-1 min-h-[44px] rounded-lg border border-transparent bg-stone-900 px-4 py-2 text-[15px] font-semibold text-white transition-colors hover:bg-stone-800"
        >
          Allow
        </button>
        <button
          id="consent-decline"
          type="button"
          class="flex-1 min-h-[44px] rounded-lg border border-stone-500 bg-white px-4 py-2 text-[15px] font-semibold text-stone-800 transition-colors hover:bg-stone-100"
        >
          Decline
        </button>
      </div>
      <a
        href="/privacy/#microsoft-clarity"
        class="inline-flex min-h-[44px] items-center text-[15px] text-orange-700 underline transition-colors hover:text-orange-800"
      >
        What gets collected
      </a>
    </div>
  </div>
</div>

<script>
  import {
    applyStoredDecision,
    denyConsent,
    grantConsent,
    onDecisionChange,
    readDecision,
    watchOtherTabs,
  } from '../scripts/consent.js';

  // Runs before the banner is touched so a stored opt-in starts Clarity as
  // early as possible, and a stored refusal starts nothing.
  applyStoredDecision();

  // This component is on every page, so it is the one place that registers the
  // cross-tab listener exactly once per document.
  watchOtherTabs();

  const banner = document.getElementById('consent-banner');

  if (banner) {
    // A `fixed` element covers whatever is beneath it, and at the end of the
    // document that strip cannot be scrolled out from under it — the footer
    // links were permanently unreachable on every page, and a focused control
    // could sit fully behind the banner (WCAG 2.2 SC 2.4.11). So while the
    // banner is up the document reserves its height twice over:
    // `padding-bottom` on the body adds scrollable room at the end, and
    // `scroll-padding-bottom` keeps the browser from parking an element it
    // scrolls into view underneath it. The height depends on the viewport
    // width, so it is measured rather than assumed, and re-measured on resize.
    const reserveSpace = () => {
      const { height } = banner.getBoundingClientRect();
      document.body.style.paddingBottom = `${height}px`;
      document.documentElement.style.scrollPaddingBottom = `${height}px`;
    };

    const releaseSpace = () => {
      document.body.style.paddingBottom = '';
      document.documentElement.style.scrollPaddingBottom = '';
    };

    const resize = new ResizeObserver(reserveSpace);

    if (readDecision() === null) {
      banner.hidden = false;
      reserveSpace();
      resize.observe(banner);
    }
    // Also covers the revoke button on /privacy/ and a decision taken in
    // another tab, both of which record a decision while this banner is still
    // on screen.
    onDecisionChange(() => {
      // Order is load-bearing. Hiding the banner makes the observer queue a
      // 0×0 record; only because `disconnect()` runs in the same task is that
      // record dropped before `reserveSpace` could write `0px`. Swap
      // `disconnect()` and `releaseSpace()` and `padding-bottom: 0px` stays
      // behind as an inline style instead of being cleared.
      banner.hidden = true;
      resize.disconnect();
      releaseSpace();
    });
    document.getElementById('consent-allow')?.addEventListener('click', () => {
      grantConsent();
    });
    document.getElementById('consent-decline')?.addEventListener('click', () => {
      denyConsent();
    });
  }
</script>
