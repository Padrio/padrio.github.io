---
import { Icon } from 'astro-icon/components';

// Kernkompetenzen - prominent dargestellt
const coreStack = [
  { name: 'PHP', icon: 'simple-icons:php' },
  { name: 'Laminas', icon: 'simple-icons:zend' },
  { name: 'Docker', icon: 'simple-icons:docker' },
  { name: 'Linux', icon: 'simple-icons:linux' },
];

// Sekundäre Skills - dezente Mono-Pills
const secondaryStack = ['Laravel', 'MySQL', 'Git', 'Nginx', 'Kubernetes', 'React', 'CI/CD'];

// AI-gestützte Arbeitsweise - eigene Gruppe, gleiche Optik wie coreStack
const aiStack = [
  { name: 'Claude', icon: 'simple-icons:claude' },
  { name: 'Codex', icon: 'simple-icons:openai' },
  { name: 'Cursor', icon: 'simple-icons:cursor' },
];

const aiSecondary = ['Paperclip', 'MCP', 'vLLM', 'Ollama', 'Hugging Face', 'RAG', 'n8n', 'AI code review'];
---

<header id="top" class="max-w-[760px] mx-auto px-4 sm:px-7 pt-16 sm:pt-[92px] pb-6 text-center flex flex-col items-center">
  <div data-reveal>
    <img
      src="/images/profile.webp"
      alt="Pascal Krason"
      width="132"
      height="132"
      class="w-[132px] h-[132px] rounded-full object-cover bg-stone-100 shadow-[0_0_0_4px_#fafaf9,0_0_0_6px_#fdba74]"
      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
    />
    <div class="w-[132px] h-[132px] rounded-full bg-stone-100 shadow-[0_0_0_4px_#fafaf9,0_0_0_6px_#fdba74] items-center justify-center text-4xl font-bold text-stone-600" style="display: none;">
      PK
    </div>
  </div>

  <h1 data-reveal class="font-extrabold text-[clamp(2.5rem,9vw,3.25rem)] leading-[1.05] tracking-[-0.035em] text-stone-900 mt-[30px]">
    Pascal Krason
  </h1>
  <p data-reveal class="text-[19px] text-stone-600 mt-3.5">
    Solutions Architect &amp; Backend Engineer
  </p>
  <p data-reveal class="font-mono text-[13px] text-stone-500 mt-2 tracking-[0.01em]">
    Architecture&ensp;·&ensp;Test harnesses&ensp;·&ensp;AI agent teams
  </p>

  <!-- availability — CTA into the contact section -->
  <!-- data-reveal sits on the wrapper: it sets the `transition` shorthand, which on the
       anchor itself would override the hover transition below -->
  <div data-reveal class="mt-[18px]">
    <a
      href="#contact"
      class="group inline-flex items-center gap-2.5 pl-[15px] pr-[13px] min-h-[44px] border border-stone-200 bg-white rounded-full shadow-xs hover:border-orange-300 hover:shadow focus-visible:border-orange-300 transition-[border-color,box-shadow]"
    >
      <span
        aria-hidden="true"
        class="w-[7px] h-[15px] rounded-[1px] bg-emerald-600 motion-safe:animate-caret group-hover:animate-none group-focus-visible:animate-none"
      ></span>
      <span class="font-mono text-xs text-stone-700 tracking-[0.01em]">
        Available for projects<span class="hidden sm:inline"> &amp; freelance work</span>
      </span>
      <span
        aria-hidden="true"
        class="text-stone-500 group-hover:text-orange-600 group-focus-visible:text-orange-600 group-hover:translate-x-0.5 group-focus-visible:translate-x-0.5 transition-[color,transform,translate]"
      >&rarr;</span>
    </a>
  </div>

  <!-- socials -->
  <div data-reveal class="flex gap-3 mt-6">
    <a
      href="https://github.com/Padrio"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
      class="w-[46px] h-[46px] flex items-center justify-center bg-white border border-stone-200 rounded-xl text-stone-900 shadow-xs hover:border-stone-300 hover:text-orange-600 transition-colors"
    >
      <Icon name="simple-icons:github" class="w-5 h-5" />
    </a>
    <a
      href="https://www.linkedin.com/in/pascal-krason-b74028326/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn"
      class="w-[46px] h-[46px] flex items-center justify-center bg-white border border-stone-200 rounded-xl text-stone-900 shadow-xs hover:border-stone-300 hover:text-orange-600 transition-colors"
    >
      <Icon name="simple-icons:linkedin" class="w-5 h-5" />
    </a>
  </div>

  <!-- tech stack -->
  <div data-reveal class="mt-[52px] w-full">
    <p class="font-mono text-[11.5px] tracking-[0.16em] text-stone-500 uppercase mb-[22px]">Tech Stack</p>
    <ul class="flex justify-center gap-6 sm:gap-[30px] flex-wrap list-none m-0 p-0">
      {coreStack.map((tech) => (
        <li class="flex flex-col items-center gap-[9px]">
          <div class="w-14 h-14 rounded-[14px] bg-white border border-stone-200 flex items-center justify-center text-stone-900 shadow-xs">
            <Icon name={tech.icon} class="w-7 h-7" aria-hidden="true" />
          </div>
          <span class="text-[12.5px] text-stone-500">{tech.name}</span>
        </li>
      ))}
    </ul>
    <ul class="flex justify-center gap-2.5 flex-wrap mt-5 list-none m-0 p-0">
      {secondaryStack.map((name) => (
        <li class="font-mono text-xs text-stone-500 px-[11px] py-[5px] border border-stone-200 rounded-full">
          {name}
        </li>
      ))}
    </ul>
  </div>

  <!-- AI stack — second group, same optics as the tech stack above.
       mt-10 is deliberately tighter than the mt-[52px] of the block above, so both
       groups read as one pair and the about paragraph stays clearly set apart. -->
  <div data-reveal class="mt-10 w-full">
    <p class="font-mono text-[11.5px] tracking-[0.16em] text-stone-500 uppercase mb-[22px]">AI-Augmented Workflow</p>
    <ul class="flex justify-center gap-6 sm:gap-[30px] flex-wrap list-none m-0 p-0">
      {aiStack.map((tech) => (
        <li class="flex flex-col items-center gap-[9px]">
          <div class="w-14 h-14 rounded-[14px] bg-white border border-stone-200 flex items-center justify-center text-stone-900 shadow-xs">
            <Icon name={tech.icon} class="w-7 h-7" aria-hidden="true" />
          </div>
          <span class="text-[12.5px] text-stone-500">{tech.name}</span>
        </li>
      ))}
    </ul>
    <ul class="flex justify-center gap-2.5 flex-wrap mt-5 list-none m-0 p-0">
      {aiSecondary.map((name) => (
        <li class="font-mono text-xs text-stone-500 px-[11px] py-[5px] border border-stone-200 rounded-full">
          {name}
        </li>
      ))}
    </ul>
  </div>

  <!-- about -->
  <p data-reveal class="text-[22px] sm:text-[23px] leading-[1.45] font-semibold text-stone-900 max-w-[600px] mt-12 sm:mt-16 tracking-[-0.015em] text-pretty">
    Anyone can ship the feature. The hard part is proving it still obeys the rules next year. <span class="text-orange-600">That's the part I build.</span>
  </p>
  <p data-reveal class="text-[17px] leading-[1.72] text-stone-600 max-w-[580px] mt-[22px] text-pretty">
    <strong class="text-stone-800 font-semibold">10+ years</strong> as a backend engineer and solutions architect. I build the scaffolding a domain needs before the first feature exists: the architecture, the test harness that encodes its rules, and the AI agent teams that ship against it. When billing is dictated by statute, the statute belongs in the test suite — not buried in a service class. Currently driving API modernization and AI-assisted workflows at Stoll von Gáti; alongside client work I run my own product portfolio: multi-tenant SaaS, IoT backends with OTA firmware rollouts, and billing software for legally defined processes.
  </p>
</header>
