---
import { Icon } from 'astro-icon/components';

// Kernkompetenzen - prominent dargestellt
const coreStack = [
  { name: 'PHP', icon: 'simple-icons:php' },
  { name: 'Laminas', icon: 'simple-icons:zend' },
  { name: 'Docker', icon: 'simple-icons:docker' },
  { name: 'Linux', icon: 'simple-icons:linux' },
];

// Sekundäre Skills - dezente Mono-Pills
const secondaryStack = ['Laravel', 'MySQL', 'Git', 'Nginx', 'Kubernetes', 'React', 'CI/CD'];
---

<header id="top" class="max-w-[760px] mx-auto px-4 sm:px-7 pt-16 sm:pt-[92px] pb-6 text-center flex flex-col items-center">
  <div data-reveal>
    <img
      src="/images/profile.jpg"
      alt="Pascal Krason"
      width="132"
      height="132"
      class="w-[132px] h-[132px] rounded-full object-cover bg-stone-100 shadow-[0_0_0_4px_#fafaf9,0_0_0_6px_#fdba74]"
      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
    />
    <div class="w-[132px] h-[132px] rounded-full bg-stone-100 shadow-[0_0_0_4px_#fafaf9,0_0_0_6px_#fdba74] items-center justify-center text-4xl font-bold text-stone-400" style="display: none;">
      PK
    </div>
  </div>

  <h1 data-reveal class="font-extrabold text-[clamp(2.5rem,9vw,3.25rem)] leading-[1.05] tracking-[-0.035em] text-stone-900 mt-[30px]">
    Pascal Krason
  </h1>
  <p data-reveal class="text-[19px] text-stone-600 mt-3.5">
    Backend Developer &amp; Solutions Architect
  </p>
  <p data-reveal class="font-mono text-[13px] text-stone-500 mt-2 tracking-[0.01em]">
    PHP + AI-Augmented Engineering&ensp;·&ensp;SaaS, IoT &amp; compliance software
  </p>

  <!-- availability — small craft signal -->
  <div data-reveal class="inline-flex items-center gap-2 mt-[18px] px-[13px] py-1.5 border border-stone-200 bg-white rounded-full">
    <span class="w-2 h-2 rounded-full bg-emerald-500 motion-safe:animate-pulse-dot" aria-hidden="true"></span>
    <span class="font-mono text-xs text-stone-600 tracking-[0.01em]">Available for backend / DevOps roles</span>
  </div>

  <!-- socials -->
  <div data-reveal class="flex gap-3 mt-6">
    <a
      href="https://github.com/Padrio"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub"
      class="w-[46px] h-[46px] flex items-center justify-center bg-white border border-stone-200 rounded-xl text-stone-900 shadow-sm hover:border-stone-300 hover:text-orange-600 transition-colors"
    >
      <Icon name="simple-icons:github" class="w-5 h-5" />
    </a>
    <a
      href="https://www.linkedin.com/in/pascal-krason-b74028326/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn"
      class="w-[46px] h-[46px] flex items-center justify-center bg-white border border-stone-200 rounded-xl text-stone-900 shadow-sm hover:border-stone-300 hover:text-orange-600 transition-colors"
    >
      <Icon name="simple-icons:linkedin" class="w-5 h-5" />
    </a>
  </div>

  <!-- tech stack -->
  <div data-reveal class="mt-[52px] w-full">
    <p class="font-mono text-[11.5px] tracking-[0.16em] text-stone-500 uppercase mb-[22px]">Tech Stack</p>
    <ul class="flex justify-center gap-6 sm:gap-[30px] flex-wrap list-none m-0 p-0">
      {coreStack.map((tech) => (
        <li class="flex flex-col items-center gap-[9px]">
          <div class="w-14 h-14 rounded-[14px] bg-white border border-stone-200 flex items-center justify-center text-stone-900 shadow-sm">
            <Icon name={tech.icon} class="w-7 h-7" aria-hidden="true" />
          </div>
          <span class="text-[12.5px] text-stone-500">{tech.name}</span>
        </li>
      ))}
    </ul>
    <ul class="flex justify-center gap-2.5 flex-wrap mt-5 list-none m-0 p-0">
      {secondaryStack.map((name) => (
        <li class="font-mono text-xs text-stone-500 px-[11px] py-[5px] border border-stone-200 rounded-full">
          {name}
        </li>
      ))}
    </ul>
  </div>

  <!-- about -->
  <p data-reveal class="text-[22px] sm:text-[23px] leading-[1.45] font-semibold text-stone-900 max-w-[600px] mt-12 sm:mt-16 tracking-[-0.015em] text-pretty">
    Most PHP/Laravel devs don't ship to RFID payments and firefighter dispatch. <span class="text-orange-600">I do.</span>
  </p>
  <p data-reveal class="text-[17px] leading-[1.72] text-stone-600 max-w-[580px] mt-[22px] text-pretty">
    <strong class="text-stone-800 font-semibold">10+ years</strong> as a Backend Developer &amp; Solutions Architect, specialized in PHP / Laravel / Laminas — currently driving API modernization and AI-assisted workflows at Stoll von Gáti. Alongside client work I run my own product portfolio: multi-tenant SaaS, IoT backends with OTA firmware rollouts, and compliance-driven software for regulated domains.
  </p>
</header>
