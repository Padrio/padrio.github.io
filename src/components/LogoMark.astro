---
// PK logo mark ("Kompakt"): PK in four orange-600 crop marks.
// Rendered from the static asset /logo-mark.svg (type already converted to paths),
// so no SVG paths live in component code (rule 5). Source files and print variants:
// brand/logo/. Decorative: the link or text next to it carries the name.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<img src="/logo-mark.svg" alt="" width={size} height={size} class={className} decoding="async" />
