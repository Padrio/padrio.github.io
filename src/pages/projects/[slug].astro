---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects: CollectionEntry<'projects'>[] = await getCollection('projects');
  // Newest first, then alphabetically by id — must stay identical to the sort in
  // src/pages/index.astro and src/pages/projects/index.astro, so the "Selected
  // Works" grid, the /projects/ overview and prev/next all agree.
  // The id tie-breaker is what keeps konteo-panel and konteo-provision (same date)
  // in a stable order instead of inheriting the glob loader's file-read race.
  // Locale-independent on purpose, see the note in src/pages/index.astro.
  const sortedProjects = projects.sort(
    (a, b) =>
      new Date(b.data.date).getTime() - new Date(a.data.date).getTime() ||
      (a.id < b.id ? -1 : a.id > b.id ? 1 : 0)
  );

  return sortedProjects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      prevProject: sortedProjects[index + 1] || null,
      nextProject: sortedProjects[index - 1] || null,
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prevProject: CollectionEntry<'projects'> | null;
  nextProject: CollectionEntry<'projects'> | null;
}

const { project, prevProject, nextProject } = Astro.props;
const { Content, headings } = await render(project);

// Calculate reading time (~200 words per minute)
const content = await project.body;
const words = content?.split(/\s+/).length || 0;
const readingTime = Math.max(1, Math.ceil(words / 200));

// Filter headings for TOC (h2 and h3 only)
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

// SoftwareApplication structured data for richer SEO surface
const projectJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": project.data.title,
  "description": project.data.description,
  // Resolved the same way as og:image in Layout.astro, so both carry the byte-identical
  // URL (rule 9). String interpolation would not: new URL() percent-encodes the path.
  ...(project.data.image && {
    "image": new URL(project.data.image, Astro.site || 'https://pkrason.de').href,
  }),
  "url": `https://pkrason.de/projects/${project.id}`,
  "datePublished": project.data.date,
  "author": {
    "@type": "Person",
    "name": "Pascal Krason",
    "url": "https://pkrason.de"
  },
  "applicationCategory": "BusinessApplication",
  ...(project.data.tags && { "keywords": project.data.tags.join(", ") }),
  ...(project.data.demo && { "sameAs": [project.data.demo] })
};
---

<Layout title={`${project.data.title} - Portfolio`} description={project.data.description} image={project.data.image}>
  <script type="application/ld+json" set:html={JSON.stringify(projectJsonLd)} is:inline />
  <!-- Scroll Progress Indicator -->
  <div id="progress-bar" class="fixed top-0 left-0 h-[3px] bg-orange-600 z-[60] transition-[width] duration-75" style="width: 0%" aria-hidden="true"></div>

  <article>
    <!-- Header -->
    <div class="max-w-content mx-auto px-4 sm:px-7 pt-8 sm:pt-11">
      <!-- data-reveal lives on the wrapper, not the <a>: the unlayered reveal rule's
           `transition` shorthand would otherwise override transition-colors. -->
      <div data-reveal>
        <a
          href="/projects/"
          class="inline-flex items-center gap-[7px] text-[14.5px] font-medium text-stone-500 hover:text-orange-600 transition-colors mb-7 py-2 min-h-[44px]"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
          Back to Projects
        </a>
      </div>

      <h1 data-reveal class="font-extrabold text-[clamp(2.25rem,7vw,3.25rem)] leading-[1.05] tracking-[-0.035em] text-stone-900 mb-[22px] max-w-[16ch]">
        {project.data.title}
      </h1>
      <p data-reveal class="text-[19px] sm:text-[21px] leading-[1.55] text-stone-500 max-w-[60ch] mb-9 sm:mb-11 text-pretty">
        {project.data.description}
      </p>

      {project.data.image && (
        <div data-reveal>
          <img
            src={project.data.image}
            alt={`Screenshot of ${project.data.title}`}
            class="w-full h-[240px] sm:h-[340px] lg:h-[460px] object-cover object-top rounded-[20px] ring-1 ring-stone-200 shadow-[0_40px_80px_-40px_rgba(28,25,23,0.35)]"
          />
        </div>
      )}
    </div>

    <!-- Body: prose + sticky sidebar -->
    <div class="max-w-content mx-auto px-4 sm:px-7 pt-12 lg:pt-16 lg:grid lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-16 lg:items-start">
      <div class="prose-project">
        <Content />
      </div>

      <aside class="mt-12 lg:mt-0 lg:sticky lg:top-[92px]">
        <div class="bg-white border border-stone-200 rounded-2xl p-6 shadow-[0_1px_3px_rgba(28,25,23,0.04)]">
          <div class="flex items-center gap-2 text-[13.5px] text-stone-500">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
            </svg>
            ~{readingTime} min read
          </div>

          <div class="h-px bg-stone-100 my-[18px]" aria-hidden="true"></div>

          <h2 class="font-mono text-[10.5px] tracking-[0.12em] uppercase text-stone-500 mb-2">Date</h2>
          <time datetime={project.data.date} class="text-[15px] font-semibold text-stone-800">
            {new Date(project.data.date).toLocaleDateString('de-DE', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>

          {project.data.tags && project.data.tags.length > 0 && (
            <>
              <div class="h-px bg-stone-100 my-[18px]" aria-hidden="true"></div>
              <h2 class="font-mono text-[10.5px] tracking-[0.12em] uppercase text-stone-500 mb-3">Technologies</h2>
              <div class="flex flex-wrap gap-1.5">
                {project.data.tags.map((tag: string) => (
                  <span class="text-xs text-stone-600 bg-stone-100 border border-stone-200/70 px-[9px] py-1 rounded-[7px]">
                    {tag}
                  </span>
                ))}
              </div>
            </>
          )}

          {(project.data.github || project.data.demo) && (
            <>
              <div class="h-px bg-stone-100 my-[18px]" aria-hidden="true"></div>
              <h2 class="font-mono text-[10.5px] tracking-[0.12em] uppercase text-stone-500 mb-2.5">Links</h2>
              <div class="flex flex-col gap-2">
                {project.data.github && (
                  <a
                    href={project.data.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-[7px] text-sm font-medium text-orange-600 hover:text-orange-700 transition-colors min-h-[44px]"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/>
                    </svg>
                    GitHub Repository
                  </a>
                )}
                {project.data.demo && (
                  <a
                    href={project.data.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-[7px] text-sm font-medium text-orange-600 hover:text-orange-700 transition-colors min-h-[44px]"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14L21 3"/>
                    </svg>
                    Live Demo
                  </a>
                )}
              </div>
            </>
          )}

          {tocHeadings.length > 0 && (
            <>
              <div class="h-px bg-stone-100 my-[18px]" aria-hidden="true"></div>
              <h2 class="font-mono text-[10.5px] tracking-[0.12em] uppercase text-stone-500 mb-3">Contents</h2>
              <nav class="flex flex-col gap-0.5 border-l-2 border-stone-100" aria-label="Table of contents">
                {tocHeadings.map((heading) => (
                  <a
                    href={`#${heading.slug}`}
                    data-toc-link={heading.slug}
                    class={`-ml-0.5 border-l-2 border-transparent transition-colors hover:text-orange-600 ${
                      heading.depth === 3
                        ? 'text-[13px] text-stone-500 py-1 pl-[26px]'
                        : 'text-[13.5px] text-stone-600 py-[5px] pl-3.5'
                    }`}
                  >
                    {heading.text}
                  </a>
                ))}
              </nav>
            </>
          )}
        </div>
      </aside>
    </div>

    <!-- Prev/Next Navigation -->
    {(prevProject || nextProject) && (
      <nav class="max-w-content mx-auto px-4 sm:px-7 mt-16 sm:mt-20" aria-label="Project navigation">
        <div class="h-px bg-stone-200 mb-8 sm:mb-10" aria-hidden="true"></div>
        <!-- data-reveal sits on the wrappers, not on the anchors: the reveal rule in
             global.css is unlayered, so its `transition` shorthand beats the anchor's
             transition-property utility out of @layer utilities no matter the
             specificity — which left the hover lift jumping instead of gliding. Same
             convention as Hero.astro and the Selected Works grid on the homepage. The
             wrappers are `flex` so each anchor still fills the row height the grid
             stretches the wrapper to, and the grid placement stays on the grid child. -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {prevProject && (
            <div data-reveal class="flex">
              <a
                href={`/projects/${prevProject.id}`}
                class="block w-full bg-white border border-stone-200 rounded-[14px] px-[26px] py-[22px] transition-[transform,translate,border-color,box-shadow] duration-200 hover:border-stone-300 motion-safe:hover:-translate-y-[3px] hover:shadow-[0_14px_28px_-18px_rgba(28,25,23,0.25)]"
              >
                <span class="block font-mono text-[11px] tracking-[0.1em] uppercase text-stone-500 mb-1.5">Previous</span>
                <span class="block font-bold text-[17px] text-stone-900">{prevProject.data.title}</span>
              </a>
            </div>
          )}
          {nextProject && (
            <div data-reveal class={`flex ${!prevProject ? 'sm:col-start-2' : ''}`}>
              <a
                href={`/projects/${nextProject.id}`}
                class="block w-full bg-white border border-stone-200 rounded-[14px] px-[26px] py-[22px] text-right transition-[transform,translate,border-color,box-shadow] duration-200 hover:border-stone-300 motion-safe:hover:-translate-y-[3px] hover:shadow-[0_14px_28px_-18px_rgba(28,25,23,0.25)]"
              >
                <span class="block font-mono text-[11px] tracking-[0.1em] uppercase text-stone-500 mb-1.5">Next</span>
                <span class="block font-bold text-[17px] text-stone-900">{nextProject.data.title}</span>
              </a>
            </div>
          )}
        </div>
      </nav>
    )}
  </article>
</Layout>

<script>
  // Scroll Progress Indicator
  const progressBar = document.getElementById('progress-bar');

  function updateProgress() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    if (progressBar) {
      progressBar.style.width = `${Math.min(100, progress)}%`;
    }
  }

  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  // TOC scroll-spy: highlight the section currently in view
  const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]')) as HTMLElement[];
  const sections = tocLinks
    .map((link) => document.getElementById(link.dataset.tocLink || ''))
    .filter((el): el is HTMLElement => el !== null);

  function updateSpy() {
    let current = sections.length > 0 ? sections[0].id : null;
    for (const section of sections) {
      if (section.getBoundingClientRect().top - 110 <= 0) current = section.id;
    }
    tocLinks.forEach((link) => {
      link.classList.toggle('toc-active', link.dataset.tocLink === current);
    });
  }

  if (tocLinks.length > 0) {
    window.addEventListener('scroll', updateSpy, { passive: true });
    window.addEventListener('resize', updateSpy);
    updateSpy();
  }
</script>

<style is:global>
  /* Article typography — matches the design prototype's prose spec */
  .prose-project {
    color: var(--color-stone-600);
  }

  .prose-project h2 {
    font-weight: 800;
    font-size: 28px;
    letter-spacing: -0.02em;
    color: var(--color-stone-900);
    margin: 52px 0 20px;
    scroll-margin-top: 92px;
  }

  .prose-project > h2:first-child {
    margin-top: 0;
  }

  .prose-project h3 {
    font-weight: 700;
    font-size: 18.5px;
    color: var(--color-stone-900);
    margin: 32px 0 10px;
    scroll-margin-top: 92px;
  }

  .prose-project p {
    font-size: 16.5px;
    line-height: 1.75;
    margin: 0 0 18px;
  }

  .prose-project a {
    color: var(--color-orange-600);
    text-decoration: none;
    /* orange-200 has no utility usage anywhere in src/; this var() reference is
       the only thing that makes Tailwind emit --color-orange-200. Without the
       fallback an undefined var() would take the whole border-bottom shorthand
       down with it and the underline would vanish — the build stays green either
       way. The fallback is the current Tailwind 4 oklch value, not a pinned
       sRGB one. */
    border-bottom: 1px solid var(--color-orange-200, oklch(90.1% 0.076 70.697));
    transition: border-color 0.2s;
  }

  .prose-project a:hover {
    border-color: var(--color-orange-600);
  }

  .prose-project strong {
    color: var(--color-stone-800);
    font-weight: 600;
  }

  .prose-project code {
    /* Literal copy of theme.extend.fontFamily.mono in tailwind.config.mjs — change
       it in both places. The duplication is not a quirk of this file but a
       consequence of this <style is:global> carrying no @reference: without one,
       `@apply font-mono` fails the build outright and a `theme` lookup for
       fontFamily resolves silently to Tailwind's own ui-monospace stack instead
       of JetBrains Mono (a colour lookup in the same block fails loudly).
       The style blocks in legal.astro and privacy.astro do carry @reference,
       which is why both idioms resolve correctly there. var(--font-mono) is no
       way out either: Tailwind 4 inlines fontFamily from a legacy @config
       straight into the .font-mono utility and never defines --font-mono, so
       var(--font-mono) would be dead code here and would invalidate the
       declaration. The `theme` lookup above is written without its call
       parentheses on purpose: the pr-build gate greps src/ for the
       parenthesized form and does not exempt comments. */
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.84em;
    background: var(--color-stone-100);
    border: 1px solid rgb(231 229 228 / 0.8);
    padding: 1px 6px;
    border-radius: 5px;
    color: var(--color-stone-700);
    /* Not `white-space: nowrap`: an inline code span wider than the content
       column cannot wrap and pushes the whole document sideways (a 68-char span
       measured 558px against a 358px column at a 390px viewport).

       Two separate things do the work here, and they are easy to confuse.
       Dropping `nowrap` restores every *normal* break opportunity inside a span
       — space, hyphen, slash — so a short identifier may now split at its
       hyphen on a narrow screen even though it would have fit on a line of its
       own (`oapi-codegen` splits at 360px, `spatie/laravel-permission` at
       375px). That is the cost of this rule, not an accident.
       `overflow-wrap: break-word` then covers the spans that have *no* break
       opportunity at all, and it is load-bearing, not decoration: with `nowrap`
       gone but `overflow-wrap: normal`, a 320px viewport still measures
       scrollWidth 382, because `METHOD\nPATH\nSHA256(BODY)\nTIMESTAMP\nNONCE`
       is one unbreakable 44-char token.

       `break-word` rather than `anywhere` because it leaves the min-content
       width alone. The two are indistinguishable today — the only min-content
       sensitive ancestor is the `lg:grid-cols-[minmax(0,1fr)_280px]` track
       above, whose minimum is already capped at 0 — so this is the
       conservative choice, not a measured difference. */
    overflow-wrap: break-word;
  }

  .prose-project pre {
    background: #fff;
    border: 1px solid var(--color-stone-200);
    border-radius: 12px;
    padding: 16px;
    overflow-x: auto;
    margin: 0 0 24px;
  }

  .prose-project pre code {
    background: transparent;
    border: none;
    padding: 0;
    white-space: pre;
  }

  .prose-project ul {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .prose-project ul li {
    position: relative;
    padding-left: 22px;
    font-size: 16.5px;
    line-height: 1.7;
  }

  .prose-project ul li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 11px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-orange-400);
  }

  .prose-project ol {
    margin: 0 0 24px;
    padding-left: 24px;
  }

  .prose-project ol li {
    font-size: 16.5px;
    line-height: 1.7;
    margin-bottom: 10px;
  }

  .prose-project ol li::marker {
    color: var(--color-orange-400);
    font-weight: 600;
  }

  .prose-project blockquote {
    border-left: 4px solid var(--color-orange-300);
    background: rgb(255 247 237 / 0.5);
    padding: 16px 16px 16px 24px;
    margin: 0 0 24px;
    border-radius: 0 8px 8px 0;
    color: var(--color-stone-700);
  }

  .prose-project blockquote p:last-child {
    margin-bottom: 0;
  }

  .prose-project img {
    border-radius: 14px;
    box-shadow: 0 0 0 1px var(--color-stone-200);
    margin: 32px 0;
  }

  .prose-project hr {
    border: none;
    height: 1px;
    background: var(--color-stone-200);
    margin: 32px 0;
  }

  /* Active TOC entry (toggled by the scroll-spy script) */
  .toc-active {
    color: var(--color-orange-600) !important;
    border-left-color: var(--color-orange-600) !important;
    font-weight: 600;
  }
</style>
