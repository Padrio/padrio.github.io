---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects', ({ data }) => data.featured);
const featuredProjects = projects
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map((p) => ({
    title: p.data.title,
    description: p.data.description,
    tags: p.data.tags || [],
    href: `/projects/${p.slug}`,
    image: p.data.image,
    flagship: p.data.flagship,
  }));
---

<Layout title="Portfolio - Pascal Krason" description="Backend Developer & Solutions Architect">
  <Hero />

  <CareerTimeline />

  <section id="works" class="max-w-content mx-auto px-4 sm:px-7 pt-20 sm:pt-[110px] scroll-mt-20">
    <div data-reveal class="text-center mb-10 sm:mb-14">
      <p class="font-mono text-[11.5px] tracking-[0.16em] text-orange-600 uppercase mb-3.5">Portfolio</p>
      <h2 class="font-extrabold text-[clamp(2rem,6vw,2.5rem)] tracking-[-0.03em] text-stone-900">Selected Works</h2>
      <p class="text-[17px] text-stone-500 mt-3.5 max-w-[520px] mx-auto leading-relaxed">
        A selection of projects I've worked on, showcasing my expertise in backend development and system administration.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[22px] items-stretch">
      {featuredProjects.map((project) => (
        <div data-reveal class="flex">
          <ProjectCard
            title={project.title}
            description={project.description}
            href={project.href}
            image={project.image}
            tags={project.tags}
            flagship={project.flagship}
          />
        </div>
      ))}
    </div>

    <!-- contact strip -->
    <div id="contact" data-reveal class="mt-20 sm:mt-[110px] bg-stone-900 rounded-[22px] px-6 py-10 sm:px-12 sm:py-14 text-center scroll-mt-20">
      <p class="font-mono text-[11.5px] tracking-[0.16em] text-[#38e08b] uppercase mb-4">// Let's talk</p>
      <h2 class="font-extrabold text-[clamp(1.75rem,5vw,2.125rem)] tracking-[-0.02em] text-white mb-3.5">
        Have a backend or infra problem?
      </h2>
      <p class="text-[17px] text-stone-400 max-w-[480px] mx-auto mb-7 leading-relaxed">
        I'm open to backend / DevOps roles and selective freelance work. Let's build something that just keeps running.
      </p>
      <a
        href="mailto:hello@pkrason.de"
        class="inline-block text-[15px] font-semibold text-stone-900 bg-white hover:bg-stone-100 transition-colors px-[26px] py-3.5 rounded-[10px]"
      >
        Get in touch →
      </a>
    </div>
  </section>
</Layout>
