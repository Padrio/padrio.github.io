---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects', ({ data }) => data.featured);
// Newest first, then alphabetically by id. konteo-panel and konteo-provision share
// a date, so without the id tie-breaker their order is whatever getCollection()
// happens to return — and the glob loader resolves its file reads concurrently,
// so that order is a race that can differ between two builds of the same commit.
// The comparison is deliberately locale-independent: localeCompare() would make
// the output depend on the runner's ICU version and default locale.
// Keep this in sync with the identical sort in src/pages/projects/[slug].astro,
// which drives prev/next, and in src/pages/projects/index.astro, which lists
// every project including the ones the `featured` filter above drops here.
const featuredProjects = projects
  .sort(
    (a, b) =>
      new Date(b.data.date).getTime() - new Date(a.data.date).getTime() ||
      (a.id < b.id ? -1 : a.id > b.id ? 1 : 0)
  )
  .map((p) => ({
    title: p.data.title,
    description: p.data.description,
    tags: p.data.tags || [],
    href: `/projects/${p.id}`,
    image: p.data.image,
    flagship: p.data.flagship,
  }));
---

<Layout title="Portfolio - Pascal Krason" description="Solutions Architect & backend engineer — architecture, test harnesses and AI agent teams for systems that have to be provably correct.">
  <Hero />

  <CareerTimeline />

  <section id="works" class="max-w-content mx-auto px-4 sm:px-7 pt-20 sm:pt-[110px] scroll-mt-20">
    <div data-reveal class="text-center mb-10 sm:mb-14">
      <p class="font-mono text-[11.5px] tracking-[0.16em] text-orange-600 uppercase mb-3.5">Portfolio</p>
      <h2 class="font-extrabold text-[clamp(2rem,6vw,2.5rem)] tracking-[-0.03em] text-stone-900">Selected Works</h2>
      <p class="text-[17px] text-stone-500 mt-3.5 max-w-[520px] mx-auto leading-relaxed">
        Systems where correctness is defined by statute, hardware or a dispatch protocol — cashless payment fleets, guardianship billing, fire-department scheduling.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[22px] items-stretch">
      {featuredProjects.map((project) => (
        <div data-reveal class="flex">
          <ProjectCard
            title={project.title}
            description={project.description}
            href={project.href}
            image={project.image}
            tags={project.tags}
            flagship={project.flagship}
          />
        </div>
      ))}
    </div>

    {/* The home page's entrance into /projects/; the other inbound link is the
        "Back to Projects" link in src/pages/projects/[slug].astro, which every
        detail page carries. Without either of them the overview page would be
        the orphan this grid's `featured` filter used to create. data-reveal
        sits on the wrapper, not the <a>: the unlayered reveal rule's
        `transition` shorthand would otherwise override transition-colors. */}
    <div data-reveal class="mt-10 sm:mt-12 text-center">
      <a
        href="/projects/"
        class="inline-flex items-center gap-[7px] text-[15px] font-semibold text-orange-700 hover:text-orange-800 transition-colors py-2 min-h-[44px]"
      >
        View all projects
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 6l6 6-6 6"/>
        </svg>
      </a>
    </div>

    <!-- contact strip -->
    <div id="contact" data-reveal class="mt-20 sm:mt-[110px] bg-stone-900 rounded-[22px] px-6 py-10 sm:px-12 sm:py-14 text-center scroll-mt-20">
      <p class="font-mono text-[11.5px] tracking-[0.16em] text-[#38e08b] uppercase mb-4">// Let's talk</p>
      <h2 class="font-extrabold text-[clamp(1.75rem,5vw,2.125rem)] tracking-[-0.02em] text-white mb-3.5">
        Have a system that has to be right?
      </h2>
      <p class="text-[17px] text-stone-400 max-w-[480px] mx-auto mb-7 leading-relaxed">
        Rules that cannot be broken, hardware out in the field, audits that have to pass — that's the work I like. I'm available for projects and selective freelance work.
      </p>
      <a
        href="mailto:hello@pkrason.de"
        class="inline-block text-[15px] font-semibold text-stone-900 bg-white hover:bg-stone-100 transition-colors px-[26px] py-3.5 rounded-[10px]"
      >
        Get in touch →
      </a>
    </div>
  </section>
</Layout>
