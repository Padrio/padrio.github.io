---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import '../styles/global.css';

// Self-hosted fonts (no external requests to Google).
//
// Nur die latin-Subsets. Die Default-Einstiegspunkte (`inter/400.css`) ziehen alle
// Subsets des Gewichts in das render-blockierende CSS: 53 @font-face-Regeln, darunter
// Kyrillisch, Griechisch und Vietnamesisch, die auf dieser Seite (lang="en") kein
// Zeichen braucht. Drei JetBrains-Mono-Subsets liegen ausserdem unter Vites
// assetsInlineLimit von 4096 B und landen deshalb als Base64-Data-URI *im* CSS.
//
// Der Hebel ist ausschliesslich die CSS-Groesse, nicht die Zahl der Font-Downloads:
// unicode-range verhindert korrekt, dass ein ungenutztes Subset geholt wird — beide
// Faelle laden dieselben sieben woff2 —, aber es kann die Bytes eines Data-URI nicht
// aus dem Stylesheet entfernen. Die reisen unbedingt mit, auch wenn der Browser die
// Regel anschliessend nie benutzt.
//
// Die latin-*-Einstiegspunkte tragen bewusst *keine* unicode-range (so liefert
// Fontsource sie aus). Deshalb laesst sich `latin` nicht zusammen mit `latin-ext`
// importieren: ohne Range wuerde die zweite Deklaration die erste fuer alle Zeichen
// verdecken. Es ist entweder/oder. Folge fuer den Inhalt: ein Zeichen aus
// Latin-Extended-A rendert dann per Zeichen-Fallback aus einer System-Schrift statt
// aus Inter — sichtbar, aber nicht kaputt. Das gebaute HTML enthaelt heute kein
// solches Zeichen; einziges Zeichen ausserhalb von latin ist der Pfeil U+2192, und
// der lag in keiner der 53 vorherigen Ranges, fiel also schon vorher zurueck.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-800.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: string;
}

// Default OG image: dedicated 1200x630 share card — the ratio the platforms crop to.
// PNG rather than WebP because WebP preview support differs across platforms.
// Override per page with the image prop.
const DEFAULT_OG_IMAGE = '/images/og-image.png';
const {
  title,
  description = 'Solutions Architect & backend engineer — architecture, test harnesses and AI agent teams for systems that have to be provably correct.',
  image,
  lang = 'en',
} = Astro.props;
const ogLocales: Record<string, string> = { en: 'en_US', de: 'de_DE' };
// Look up on the normalized base subtag so regional tags (de-DE, DE) map to their locale
const ogLocale = ogLocales[lang.split('-')[0].toLowerCase()] ?? ogLocales.en;
const siteURL = Astro.site || 'https://pkrason.de';
const canonicalURL = new URL(Astro.url.pathname, siteURL);
// og:image and twitter:image must be absolute: the crawlers that read them have no
// document base to resolve a root-relative path against. Same pattern as canonicalURL.
// An already absolute image prop passes through new URL() unchanged; a blank one falls
// back to the default, because new URL('', siteURL) would ship the site root as the card.
const imageURL = new URL(image?.trim() || DEFAULT_OG_IMAGE, siteURL);

// JSON-LD Schema
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Pascal Krason",
  "jobTitle": "Solutions Architect & Backend Engineer",
  "url": "https://pkrason.de",
  "sameAs": [
    "https://github.com/Padrio",
    "https://www.linkedin.com/in/pascal-krason-b74028326/"
  ]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Marks JS availability before first paint so scroll-reveal styles only apply with JS -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/* Nothing may reference Microsoft Clarity from the head: a static import
        or even a preconnect would be a request before consent. It loads only
        after an opt-in, through the dynamic import in src/scripts/consent.js
        that ConsentBanner drives. */}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Navigation />
    <main id="main" class="relative z-10">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <script>
      import '../scripts/reveal.js';
    </script>
  </body>
</html>
